{
    "name": "stolt/composer-peel",
    "description": "A small development tool to strip development-only metadata from composer.json when preparing PHP packages for distribution.",
    "keywords": [
        "composer.json",
        "release management",
        "reduce",
        "runtime-only metadata",
        "strip development-only metadata",
        "dev"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Stolt\\ComposerPeel\\": "src/"
        }
    },
    "bin": [
        "bin/composer-peel"
    ],
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "sebastian/diff": "^6.0 || ^7.0 || ^8.0 || ^9.0",
        "symfony/console": "^7.4 || ^8.1"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
