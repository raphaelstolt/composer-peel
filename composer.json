{
    "name": "stolt/composer-peel",
    "description": "A small development tool to strip development-only metadata from composer.json when preparing PHP packages for distribution.",
    "keywords": [
        "composer.json",
        "release management",
        "reduce",
        "runtime-only metadata",
        "strip development-only metadata",
        "dev"
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Stolt\\ComposerPeel\\": "src/"
        }
    },
    "bin": [
        "bin/composer-peel"
    ],
    "autoload-dev": {
        "psr-4": {
            "Stolt\\ComposerPeel\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "sebastian/diff": "^6.0 || ^7.0 || ^8.0 || ^9.0",
        "symfony/console": "^7.4 || ^8.1"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "carthage-software/mago": true
        }
    },
    "require-dev": {
        "carthage-software/mago": "^1.50",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.3",
        "stolt/lean-package-validator": "^6.0",
        "stolt/version-aligner": "^1.1",
        "zenstruck/console-test": "^1.8"
    },
    "scripts": {
        "test": "phpunit",
        "cs-lint": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": "mago format",
        "validate-gitattributes": "./vendor/bin/lean-package-validator validate",
        "validate-package": "composer validate --strict",
        "version-check": "version-aligner check",
        "pre-commit-check": [
            "@validate-gitattributes",
            "@version-check",
            "@cs-lint",
            "@test"
        ]
    }
}
